---
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import type { MarkdownHeading } from "astro";
import { profileConfig } from "../../config";

interface Props {
  class?: string;
  headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const recentPosts = (await getSortedPosts()).slice(0, 6);
---

<aside id="sidebar" class:list={[className, "paper-panel"]} aria-label="阅读目录">
  <div class="panel-heading">阅读目录</div>
  <div class="sidebar-body">
    <div class="sidebar-identity">
      <span class="identity-eyebrow">AI AGENT · 技术笔记</span>
      <a href="/about/" class="identity-name">{profileConfig.name}</a>
      <p>{profileConfig.bio}</p>
    </div>

    <nav class="sidebar-nav" aria-label="站点目录">
      <a href="/" class="sidebar-section-link">最新文章 <span>↗</span></a>
      {recentPosts.map((post) => (
        <a href={getPostUrlBySlug(post.slug)} class="sidebar-post-link" title={post.data.title}>{post.data.title}</a>
      ))}
      <a href="/archive/" class="sidebar-section-link">全部归档 <span>›</span></a>
      <a href="/categories/" class="sidebar-section-link">主题分类 <span>›</span></a>
      <a href="/about/" class="sidebar-section-link">关于作者 <span>›</span></a>
    </nav>
  </div>
</aside>
