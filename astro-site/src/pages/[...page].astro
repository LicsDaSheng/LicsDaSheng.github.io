---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import NotebookSketch from "../components/NotebookSketch.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import SeriesCard from "../components/series/SeriesCard.astro";
import { seriesList } from "../series";
import { getFeedPosts, getSeriesPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getFeedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const columns = (
	await Promise.all(
		seriesList.map(async (s) => {
			const posts = await getSeriesPosts(s.id);
			return { series: s, count: posts.length, latest: posts.at(-1)?.data.title };
		}),
	)
).filter((c) => c.count > 0);
---

<MainGridLayout>
    {page.currentPage === 1 && <header class="home-intro paper-panel">
        <div class="eyebrow">AGENT INSIGHT · 独立技术博客</div>
        <NotebookSketch />
        <h1>记录 AI Agent 的<br /><em>技术与思考</em></h1>
        <p>我是 ScottLee · 大圣，关注 AI 原生应用开发、智能体系统与开源生态。这里是持续更新的实践笔记与深度分析。</p>
        <div class="intro-links"><a href="/about/">认识作者 <span>↗</span></a><a href="/archive/">浏览全部文章 <span>→</span></a><a href="/series/">专栏 <span>→</span></a></div>
    </header>}
    {page.currentPage === 1 && columns.length > 0 && <>
        <div class="section-heading"><span>专栏</span><span>COLUMNS</span></div>
        <div class="flex flex-col gap-4 mb-6">
            {columns.map((c) => <SeriesCard series={c.series} count={c.count} latestTitle={c.latest} />)}
        </div>
    </>}
    <div class="section-heading"><span>最新文章</span><span>RECENT WRITING</span></div>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
