---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import TOC from "@components/widget/TOC.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  banner?: string;
  description?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  headings?: MarkdownHeading[];
}

const { title, banner, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
  <slot slot="head" name="head" />
  <div id="top-row">
    <div id="navbar-wrapper"><Navbar /></div>
  </div>

  <div id="page-shell">
    <div id="main-grid">
      <SideBar headings={headings} />

      <main id="swup-container" class="transition-swup-fade">
        <div id="content-wrapper">
          <slot />
          <Footer />
        </div>
      </main>

      <aside id="toc-wrapper" aria-label="本页内容">
        <div class="paper-panel right-panel">
          <div class="panel-heading">本页内容</div>
          <div id="toc-inner-wrapper" class="hide-scrollbar">
            <div id="toc" class="transition-swup-fade">
              {siteConfig.toc.enable && headings.length > 0 ? (
                <TOC headings={headings} />
              ) : (
                <nav class="overview-links" aria-label="站点导航">
                  <a href="/">最新文章</a>
                  <a href="/archive/">文章归档</a>
                  <a href="/categories/">主题分类</a>
                  <a href="/about/">关于作者</a>
                </nav>
              )}
            </div>
          </div>
        </div>
      </aside>
    </div>
    <BackToTop />
  </div>
</Layout>
